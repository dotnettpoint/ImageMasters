<Window x:Class="ImageMaster.App.Views.AdjustmentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjustments" Height="340" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Brightness:" VerticalAlignment="Center" Margin="0,0,6,10"/>
        <Slider Grid.Row="0" Grid.Column="1" x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0"
                ValueChanged="OnSliderChanged" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="BrightnessText" Text="0" VerticalAlignment="Center" Margin="6,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Contrast:" VerticalAlignment="Center" Margin="0,0,6,10"/>
        <Slider Grid.Row="1" Grid.Column="1" x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0"
                ValueChanged="OnSliderChanged" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ContrastText" Text="0" VerticalAlignment="Center" Margin="6,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Saturation:" VerticalAlignment="Center" Margin="0,0,6,10"/>
        <Slider Grid.Row="2" Grid.Column="1" x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0"
                ValueChanged="OnSliderChanged" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SaturationText" Text="0" VerticalAlignment="Center" Margin="6,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Sharpen:" VerticalAlignment="Center" Margin="0,0,6,10"/>
        <Slider Grid.Row="3" Grid.Column="1" x:Name="SharpenSlider" Minimum="0" Maximum="100" Value="0"
                ValueChanged="OnSliderChanged" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SharpenText" Text="0" VerticalAlignment="Center" Margin="6,0,0,10"/>

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Reset All" HorizontalAlignment="Left" Padding="6,2" Click="OnResetClick"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
