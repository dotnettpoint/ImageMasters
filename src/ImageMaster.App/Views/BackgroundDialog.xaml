<Window x:Class="ImageMaster.App.Views.BackgroundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Background" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                    Text="Choose how the background should be replaced."
                    TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <RadioButton x:Name="TransparentToColorRadio" GroupName="Mode" Content="Fill transparent areas with a solid color" IsChecked="True" Checked="OnModeChanged" Margin="0,2"/>
            <RadioButton x:Name="TransparentToImageRadio" GroupName="Mode" Content="Fill transparent areas with an image" Checked="OnModeChanged" Margin="0,2"/>
            <RadioButton x:Name="ChromaKeyToColorRadio" GroupName="Mode" Content="Remove a background color, fill with solid color" Checked="OnModeChanged" Margin="0,2"/>
            <RadioButton x:Name="ChromaKeyToImageRadio" GroupName="Mode" Content="Remove a background color, fill with an image" Checked="OnModeChanged" Margin="0,2"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Note: color-based background removal is a simple threshold, not full AI segmentation - it works best on a fairly uniform, distinctly-colored background."
                    TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,10"/>

        <Grid Grid.Row="3" x:Name="FillColorPanel" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fill color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Border Grid.Column="1" x:Name="FillColorSwatch" BorderBrush="Gray" BorderThickness="1" Background="White"/>
            <Button Grid.Column="2" Content="Choose..." Margin="8,0,0,0" Click="OnChooseFillColorClick"/>
        </Grid>

        <Grid Grid.Row="4" x:Name="ReplacementImagePanel" Visibility="Collapsed" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Image:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="ReplacementImagePathBox" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseImageClick"/>
        </Grid>

        <StackPanel Grid.Row="5" x:Name="ChromaKeyPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Key color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Grid.Column="1" x:Name="KeyColorSwatch" BorderBrush="Gray" BorderThickness="1" Background="Lime"/>
                <Button Grid.Column="2" Content="Choose..." Margin="8,0,0,0" Click="OnChooseKeyColorClick"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tolerance:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" x:Name="ToleranceSlider" Minimum="0" Maximum="100" Value="25"/>
                <TextBlock Grid.Column="2" Text="{Binding ElementName=ToleranceSlider, Path=Value, StringFormat={}{0:F0}%}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="ValidationText" Foreground="Red" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Apply" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
