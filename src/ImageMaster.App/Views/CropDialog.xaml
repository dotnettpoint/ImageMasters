<Window x:Class="ImageMaster.App.Views.CropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop Image" Height="340" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SourceSizeText" Text="Current size: 0 x 0 px" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="XBox" TextChanged="OnFieldChanged"/>
            <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <TextBox Grid.Column="4" x:Name="YBox" TextChanged="OnFieldChanged"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="WidthBox" TextChanged="OnFieldChanged"/>
            <TextBlock Grid.Column="2" Text="x" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Height:" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <TextBox Grid.Column="4" x:Name="HeightBox" TextChanged="OnFieldChanged"/>
        </Grid>

        <Button Grid.Row="3" Content="Reset to Full Image" HorizontalAlignment="Left" Padding="6,2" Click="OnResetClick" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" x:Name="PreviewText" Text="Result: 0 x 0 px" FontWeight="SemiBold" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="5" x:Name="ValidationText" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
