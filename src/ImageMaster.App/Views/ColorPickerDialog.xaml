<Window x:Class="ImageMaster.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color" Height="260" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="PreviewSwatch" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="A" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" x:Name="AlphaSlider" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
            <TextBlock Grid.Column="2" Text="{Binding ElementName=AlphaSlider, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="R" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
            <TextBlock Grid.Column="2" Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="G" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
            <TextBlock Grid.Column="2" Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="B" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="OnSliderChanged"/>
            <TextBlock Grid.Column="2" Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:F0}}" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Width="70" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
