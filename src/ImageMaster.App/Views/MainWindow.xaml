<Window x:Class="ImageMaster.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="800" Width="1200"
        MinHeight="500" MinWidth="700"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousImageCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextImageCommand}"/>
    </Window.InputBindings>

    <Grid>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="_Image">
                <MenuItem Header="Rotate _Left" Command="{Binding RotateCounterClockwiseCommand}"/>
                <MenuItem Header="Rotate _Right" Command="{Binding RotateClockwiseCommand}"/>
                <Separator/>
                <MenuItem Header="_Crop Tool" Command="{Binding CropCommand}"/>
                <MenuItem Header="_Resize..." Command="{Binding ResizeCommand}"/>
                <MenuItem Header="Add/Edit _Text..." Command="{Binding AddTextCommand}"/>
                <MenuItem Header="Apply Pending Text" Command="{Binding ApplyTextCommand}"/>
                <MenuItem Header="Change _Background..." Command="{Binding BackgroundCommand}"/>
                <MenuItem Header="Change _Resolution/DPI..." Command="{Binding DpiCommand}"/>
                <Separator/>
                <MenuItem Header="_Adjustments..." Command="{Binding AdjustmentsCommand}"/>
                <MenuItem Header="_Filters">
                    <MenuItem Header="Grayscale" Command="{Binding GrayscaleFilterCommand}"/>
                    <MenuItem Header="Sepia" Command="{Binding SepiaFilterCommand}"/>
                    <MenuItem Header="Invert" Command="{Binding InvertFilterCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Navigate">
                <MenuItem Header="_Previous Image" Command="{Binding PreviousImageCommand}" InputGestureText="Alt+Left"/>
                <MenuItem Header="_Next Image" Command="{Binding NextImageCommand}" InputGestureText="Alt+Right"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Open" Command="{Binding OpenCommand}" Padding="8,2" Margin="2"/>
            <Separator/>
            <Button Content="◀ Prev" Command="{Binding PreviousImageCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Next ▶" Command="{Binding NextImageCommand}" Padding="8,2" Margin="2"/>
            <Separator/>
            <Button Content="Rotate Left" Command="{Binding RotateCounterClockwiseCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Rotate Right" Command="{Binding RotateClockwiseCommand}" Padding="8,2" Margin="2"/>
            <Separator/>
            <ToggleButton Content="Crop" Command="{Binding CropCommand}" IsChecked="{Binding IsCropToolActive, Mode=OneWay}"
                          IsEnabled="{Binding HasDocument}" Padding="8,2" Margin="2"/>
            <Button Content="Resize" Command="{Binding ResizeCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Add Text" Command="{Binding AddTextCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Background" Command="{Binding BackgroundCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Resolution" Command="{Binding DpiCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Save As" Command="{Binding SaveAsCommand}" Padding="8,2" Margin="2"/>
            <Separator/>
            <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" Padding="8,2" Margin="2"/>
            <Separator/>
            <ToggleButton Content="Eyedropper" Command="{Binding EyedropperToolCommand}" IsChecked="{Binding IsEyedropperActive, Mode=OneWay}"
                          IsEnabled="{Binding HasDocument}" Padding="8,2" Margin="2"/>
            <Border Width="22" Height="22" Margin="6,0,2,0" BorderBrush="Black" BorderThickness="1"
                    Background="{Binding PickedColorArgb, Converter={StaticResource ArgbToBrushConverter}}"/>
            <TextBlock Text="{Binding PickedColorHex}" VerticalAlignment="Center" Margin="4,0,4,0" FontFamily="Consolas"/>
            <Button Content="Copy" Command="{Binding CopyPickedColorCommand}" Padding="8,2" Margin="2"/>
            <Separator/>
            <Button Content="Adjustments" Command="{Binding AdjustmentsCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Grayscale" Command="{Binding GrayscaleFilterCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Sepia" Command="{Binding SepiaFilterCommand}" Padding="8,2" Margin="2"/>
            <Button Content="Invert" Command="{Binding InvertFilterCommand}" Padding="8,2" Margin="2"/>
            <Separator/>
            <Button x:Name="CompareButton" Content="Compare (Hold)" IsEnabled="{Binding HasDocument}" Padding="8,2" Margin="2"
                    PreviewMouseLeftButtonDown="OnCompareButtonDown" PreviewMouseLeftButtonUp="OnCompareButtonUp" LostMouseCapture="OnCompareButtonLostCapture"/>
        </ToolBar>

        <Border x:Name="CropOptionsBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFEFEFEF"
                BorderBrush="#FFCCCCCC" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Aspect ratio:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="AspectRatioCombo" Width="90" SelectionChanged="OnAspectRatioChanged">
                    <ComboBoxItem Content="Free" IsSelected="True"/>
                    <ComboBoxItem Content="1:1"/>
                    <ComboBoxItem Content="4:3"/>
                    <ComboBoxItem Content="16:9"/>
                </ComboBox>
                <Button x:Name="ApplyCropButton" Content="Apply Crop" Padding="8,2" Margin="12,0,4,0" IsEnabled="False" Click="OnApplyCropClick"/>
                <Button Content="Cancel" Padding="8,2" Margin="0,0,12,0" Click="OnCancelCropClick"/>
                <TextBlock Text="Drag to select an area. Double-click inside it or press Enter to confirm, Esc to cancel."
                           VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="True" Width="120" Height="14"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" Height="110" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Folder:" FontWeight="SemiBold" Margin="4,0,0,2"/>
                <Button DockPanel.Dock="Right" Content="Next Page ▶" Command="{Binding NextThumbnailPageCommand}" Padding="6,1" Margin="4,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="◀ Prev Page" Command="{Binding PreviousThumbnailPageCommand}" Padding="6,1"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ThumbnailPageLabel}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" Foreground="Gray"/>
            </DockPanel>
            <ListBox Grid.Row="1" x:Name="ThumbnailStrip" ItemsSource="{Binding Thumbnails}"
                      SelectedItem="{Binding SelectedThumbnail, Mode=TwoWay}"
                      SelectionChanged="OnThumbnailSelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="90" Margin="3">
                            <Image Source="{Binding Thumbnail}" Height="70" Stretch="Uniform"/>
                            <TextBlock Text="{Binding FileName}" FontSize="10" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Height="34" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider Grid.Column="1" Minimum="25" Maximum="400" Value="{Binding ZoomPercentage}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding ZoomPercentage, StringFormat={}{0:F0}%}" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="Fit to Window" Padding="8,2" Margin="10,0,0,0" Click="OnFitToWindowClick"/>
        </Grid>

        <!-- Main image canvas: pan via ScrollViewer, zoom via ScaleTransform so
             the text-overlay Canvas (same transform) stays pixel-aligned with
             the image at any zoom level. -->
        <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF2B2B2B"
                      PreviewMouseWheel="OnImageScrollViewerMouseWheel">
            <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                  PreviewMouseLeftButtonDown="OnImageHostMouseDown"
                  PreviewMouseMove="OnImageHostMouseMove"
                  MouseLeave="OnImageHostMouseLeave">
                <Grid.LayoutTransform>
                    <ScaleTransform
                        ScaleX="{Binding ZoomPercentage, Converter={StaticResource ZoomPercentageToScaleConverter}}"
                        ScaleY="{Binding ZoomPercentage, Converter={StaticResource ZoomPercentageToScaleConverter}}"/>
                </Grid.LayoutTransform>
                <Image x:Name="MainImage" Source="{Binding CurrentImageSource}" Stretch="None"/>
                <Canvas x:Name="TextOverlayCanvas" Background="Transparent"
                        Width="{Binding ElementName=MainImage, Path=Source.PixelWidth}"
                        Height="{Binding ElementName=MainImage, Path=Source.PixelHeight}"
                        PreviewMouseLeftButtonDown="OnOverlayMouseDown"
                        PreviewMouseMove="OnOverlayMouseMove"
                        PreviewMouseLeftButtonUp="OnOverlayMouseUp"/>
                <!-- Interactive crop selection: owned/rendered by CropSelectionController. -->
                <Canvas x:Name="CropOverlayCanvas" Background="Transparent" Visibility="Collapsed"
                        Width="{Binding ElementName=MainImage, Path=Source.PixelWidth}"
                        Height="{Binding ElementName=MainImage, Path=Source.PixelHeight}"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>

    <!-- Free-floating chrome that must ignore zoom/pan/panel layout: the
         eyedropper's magnifier loupe, positioned in Window coordinates. -->
    <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
        <Border x:Name="MagnifierLoupe" Visibility="Collapsed" Width="130" Height="130" Background="White"
                BorderBrush="Black" BorderThickness="2" CornerRadius="4">
            <Grid ClipToBounds="True">
                <Image x:Name="MagnifierImage" Width="120" Height="120" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Rectangle Width="1" Height="120" Fill="Red" HorizontalAlignment="Center" Opacity="0.6"/>
                <Rectangle Width="120" Height="1" Fill="Red" VerticalAlignment="Center" Opacity="0.6"/>
            </Grid>
        </Border>
    </Canvas>
    </Grid>
</Window>
