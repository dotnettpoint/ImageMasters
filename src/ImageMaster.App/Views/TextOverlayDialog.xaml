<Window x:Class="ImageMaster.App.Views.TextOverlayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add / Edit Text" Height="520" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Text layers (drag on the image canvas to reposition; this list controls content and style):" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListBox Grid.Row="1" x:Name="LayersListBox" DisplayMemberPath="Text" SelectionChanged="OnLayerSelected"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,10">
            <Button Content="Add Layer" Width="100" Margin="0,0,8,0" Click="OnAddLayerClick"/>
            <Button Content="Remove Layer" Width="100" Click="OnRemoveLayerClick"/>
        </StackPanel>

        <Grid Grid.Row="3" x:Name="EditorPanel" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Text:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TextBox" TextChanged="OnFieldChanged"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Font:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="FontFamilyCombo" SelectionChanged="OnFieldChanged" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="Size:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" x:Name="FontSizeBox" TextChanged="OnFieldChanged"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="BoldCheckBox" Content="Bold" Margin="0,0,16,0" Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>
                <CheckBox x:Name="ItalicCheckBox" Content="Italic" Checked="OnFieldChanged" Unchecked="OnFieldChanged"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Color:" VerticalAlignment="Center"/>
                <Border Grid.Column="1" x:Name="ColorSwatch" BorderBrush="Gray" BorderThickness="1" Background="White"/>
                <Button Grid.Column="2" Content="Choose..." Margin="8,0,0,0" Click="OnChooseColorClick"/>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Opacity:" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" ValueChanged="OnOpacityChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F0}%}" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Position X:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="XBox" TextChanged="OnFieldChanged"/>
                <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" x:Name="YBox" TextChanged="OnFieldChanged"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="ValidationText" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
