<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ImageMaster.App</RootNamespace>
    <AssemblyName>ImageMaster</AssemblyName>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic Host gives us a standard, testable composition root for DI
         instead of hand-rolling a service locator in App.xaml.cs. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageMaster.Core\ImageMaster.Core.csproj" />
    <ProjectReference Include="..\ImageMaster.Infrastructure\ImageMaster.Infrastructure.csproj" />
  </ItemGroup>

</Project>
